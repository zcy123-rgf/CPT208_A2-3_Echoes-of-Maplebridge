PORT=3001
VITE_API_BASE_URL=/api

# Preferred for Vercel/Aiven PostgreSQL deployments.
DATABASE_URL=postgres://avnadmin:your-password@your-aiven-host:10246/defaultdb?sslmode=require

# Optional local MySQL fallback.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-local-password
MYSQL_DATABASE=echoes_of_maplebridge
MYSQL_CONNECTION_LIMIT=10

DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_MODEL=your-doubao-model-id
DOUBAO_API_KEY=your-api-key
VITE_AMAP_KEY=your-amap-web-jsapi-key
VITE_AMAP_SECURITY_CODE=your-amap-security-js-code
